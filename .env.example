# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Vite inlines these at build time — the anon key is public by design.
#
# ---------------------------------------------------------------------------
# Room booking backend (Supabase) — REQUIRED for the host booking feature
# 1. Create a free project at https://supabase.com
# 2. SQL Editor -> New query: run supabase/setup.sql
#      !! replace __REPLACE_ME__ with your four-digit host access code !!
#      (only its SHA-256 hash is stored; the code never appears in this repo
#       or in the website's JavaScript — do NOT commit it anywhere)
# 3. SQL Editor -> New query: run supabase/seed-bookings.sql
#      (loads the existing allocations from accommodation.xlsx)
# 4. Settings -> API -> copy the Project URL and the anon public key below
# 5. Production (GitHub Pages): set the same two names as repository
#    variables under Settings -> Secrets and variables -> Actions -> Variables
#    so `npm run build` in GitHub Actions picks them up.
#
# Without these values the page still shows both properties and their room
# totals, but live counts are shown as "—" and the Host Login button is hidden.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: there is intentionally no VITE_HOST_PIN / access-code variable.
# The host access code lives only in Supabase and is verified server side on
# every login and every booking change.
